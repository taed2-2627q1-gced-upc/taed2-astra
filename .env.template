# Copy to .env and fill in. .env is gitignored - never commit a real token.
# Tokens are personal: create yours at https://dagshub.com/user/settings/tokens

# DagsHub MLflow tracking. The project name must match the GitHub repo name.
MLFLOW_TRACKING_URI=https://dagshub.com/<dagshub-owner>/taed2-astra.mlflow
MLFLOW_TRACKING_USERNAME=<your-dagshub-user>
MLFLOW_TRACKING_PASSWORD=<your-dagshub-token>

# Set to file:./mlruns to log runs locally instead of to DagsHub.
