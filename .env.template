# Copy to .env and fill in your own values:  cp .env.template .env
# .env is gitignored. Never commit a real token.
#
# Create YOUR OWN token at https://dagshub.com/user/settings/tokens
# Tokens are personal - do not share one across the team.
#
# The same token is used in two places:
#   1. MLflow  -> here, as MLFLOW_TRACKING_PASSWORD
#   2. DVC     -> .dvc/config.local, via:
#        dvc remote modify --local dagshub access_key_id     <token>
#        dvc remote modify --local dagshub secret_access_key <token>
#      (DagsHub issues one token, not a key/secret pair - use it for both.)

# Your DagsHub username, NOT the project owner.
MLFLOW_TRACKING_USERNAME=<your-dagshub-user>
MLFLOW_TRACKING_PASSWORD=<your-dagshub-token>

# Optional. params.yaml already points at the team project:
#   https://dagshub.com/Santi-49/taed2-astra.mlflow
# Uncomment to override, e.g. to log runs locally while experimenting.
# MLFLOW_TRACKING_URI=file:./mlruns
